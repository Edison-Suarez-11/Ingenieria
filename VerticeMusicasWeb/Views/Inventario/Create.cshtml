@model VerticeMusicasWeb.Models.RegistrarEntradaViewModel
@{
    ViewData["Title"] = "Nueva entrada de inventario";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" crossorigin="anonymous" />
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-modern">
            <div class="card-body p-4">
                <h3 class="mb-3">Registrar entrada</h3>
                <p class="text-muted small">Cada registro crea un movimiento de stock asociado a un proveedor y precio de compra.</p>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label"></label>
                            <input asp-for="Fecha" class="form-control" type="date" />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Cantidad" class="form-label"></label>
                            <input asp-for="Cantidad" class="form-control" min="1" />
                            <span asp-validation-for="Cantidad" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StockMinimo" class="form-label"></label>
                            <input asp-for="StockMinimo" class="form-control" min="0" />
                            <span asp-validation-for="StockMinimo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdProveedor" class="form-label"></label>
                            <select asp-for="IdProveedor" asp-items="ViewBag.Proveedores" class="form-select" id="IdProveedor">
                                <option value="">Selecciona un proveedor</option>
                            </select>
                            <span asp-validation-for="IdProveedor" class="text-danger"></span>
                            <div class="form-text">
                                <a asp-controller="Proveedores" asp-action="Index">Gestionar proveedores</a>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PrecioUnitarioCompra" class="form-label"></label>
                            <input asp-for="PrecioUnitarioCompra" class="form-control" min="0.01" step="0.01" />
                            <span asp-validation-for="PrecioUnitarioCompra" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="IdProducto" class="form-label"></label>
                            <select asp-for="IdProducto" asp-items="ViewBag.Productos" class="form-select">
                                <option value="">Selecciona un producto</option>
                            </select>
                            <span asp-validation-for="IdProducto" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-modern-primary">Guardar entrada</button>
                        <a asp-action="Index" class="btn btn-modern-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js" crossorigin="anonymous"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const opts = {
                allowEmptyOption: true,
                create: false,
                maxOptions: null,
                sortField: { field: 'text', direction: 'asc' },
                plugins: ['clear_button']
            };

            const selProd = document.getElementById('IdProducto');
            const selProv = document.getElementById('IdProveedor');
            if (typeof TomSelect === 'undefined') return;

            if (selProd) {
                new TomSelect(selProd, { ...opts, placeholder: 'Buscar producto...' });
            }
            if (selProv) {
                new TomSelect(selProv, { ...opts, placeholder: 'Buscar proveedor...' });
            }

            $(function () {
                const fixIgnore = () => {
                    $('form').each(function () {
                        const v = $(this).data('validator');
                        if (v) {
                            v.settings.ignore = ':hidden:not(#IdProducto):not(#IdProveedor)';
                        }
                    });
                };
                fixIgnore();
                setTimeout(fixIgnore, 0);
            });
        })();
    </script>
}
