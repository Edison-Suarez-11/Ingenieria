@model List<VerticeMusicasWeb.Models.InventarioMovimientoRow>
@{
    ViewData["Title"] = "Inventario";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Movimientos de inventario</h2>
        <small class="text-muted">Entradas registradas por fecha y producto.</small>
    </div>
    <a class="btn btn-modern-primary" asp-action="Create">Nueva entrada</a>
</div>

<form method="get" class="card card-modern mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label mb-0 small text-muted">Categoria</label>
            <select name="categoriaId" asp-items="ViewBag.CategoriasFiltro" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label class="form-label mb-0 small text-muted">Proveedor</label>
            <select name="proveedorId" asp-items="ViewBag.ProveedoresFiltro" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label class="form-label mb-0 small text-muted">Buscar (nombre o codigo)</label>
            <input type="text" name="q" value="@ViewBag.Term" class="form-control" placeholder="Ej: leche o 7701..." />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-modern-secondary flex-grow-1">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="card card-modern">
    <div class="card-body table-responsive">
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">No hay movimientos con los filtros actuales.</p>
        }
        else
        {
            <table class="table table-hover table-modern mb-0">
                <thead>
                    <tr>
                        <th>ID inventario</th>
                        <th>Fecha</th>
                        <th>Producto</th>
                        <th>Codigo</th>
                        <th>Categoria</th>
                        <th>Proveedor</th>
                        <th class="text-end">P. compra</th>
                        <th class="text-end">Margen %</th>
                        <th class="text-end">P. venta sug.</th>
                        <th class="text-end">Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Cantidad <= 0 ? "table-warning" : "")">
                        <td>@item.IdInventario</td>
                        <td>@item.Fecha.ToString("yyyy-MM-dd")</td>
                        <td>@item.NombreProducto</td>
                        <td>@item.CodigoBarras</td>
                        <td>@item.NombreCategoria</td>
                        <td>@(item.NombreProveedor ?? "—")</td>
                        <td class="text-end">@(item.PrecioUnitarioCompra?.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CO")) ?? "—")</td>
                        <td class="text-end">@(item.PorcentajeMargenVenta.HasValue ? item.PorcentajeMargenVenta.Value.ToString("N2") + " %" : "—")</td>
                        <td class="text-end">@(item.PrecioVentaSugerido?.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("es-CO")) ?? "—")</td>
                        <td class="text-end">@item.Cantidad</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
