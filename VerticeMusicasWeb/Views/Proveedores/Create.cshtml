@model VerticeMusicasWeb.Models.Proveedor
@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-modern">
            <div class="card-body p-4">
                <h3 class="mb-3">Nuevo Proveedor</h3>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Distribuidora Norte" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contacto" class="form-label"></label>
                        <input asp-for="Contacto" class="form-control" placeholder="Ej: 3001234567" />
                        <span asp-validation-for="Contacto" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-modern-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-modern-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
