@model List<VerticeMusicasWeb.Models.StockDisponibleRow>
@if (Model.Count > 0)
{
    <div class="alert alert-warning alert-modern mb-0 border-0 rounded-0" role="alert">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2 py-1">
            <div>
                <strong>Stock bajo:</strong>
                hay @Model.Count producto(s) en o por debajo del minimo.
                @if (Model.Count <= 3)
                {
                    <span class="ms-1">(@string.Join(", ", Model.Select(p => p.NombreProducto)))</span>
                }
            </div>
            <a class="btn btn-sm btn-outline-dark" asp-controller="ConsultaStock" asp-action="Index">Ver detalle</a>
        </div>
    </div>
}
