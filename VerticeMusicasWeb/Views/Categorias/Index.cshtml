@model IEnumerable<VerticeMusicasWeb.Models.Categoria>
@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Gestionar categorias</h2>
        <small class="text-muted">Crea, edita y filtra por nombre.</small>
    </div>
    <a class="btn btn-modern-primary" asp-action="Create">Nueva categoria</a>
</div>

<form method="get" class="card card-modern mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-8">
            <label class="form-label mb-0 small text-muted">Buscar por nombre</label>
            <input type="text" name="q" value="@ViewBag.Term" class="form-control" placeholder="Ej: Lacteos" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-modern-secondary flex-grow-1">Buscar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

<div class="card card-modern">
    <div class="card-body table-responsive">
        <table class="table table-hover table-modern mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre de categoria</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.IdCategoria</td>
                    <td>@item.NombreCategoria</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-modern-secondary" asp-action="Edit" asp-route-id="@item.IdCategoria">Editar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
