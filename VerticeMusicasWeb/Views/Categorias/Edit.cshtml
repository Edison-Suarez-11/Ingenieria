@model VerticeMusicasWeb.Models.Categoria
@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-modern">
            <div class="card-body p-4">
                <h3 class="mb-3">Editar Categoria</h3>
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="IdCategoria" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="NombreCategoria" class="form-label"></label>
                        <input asp-for="NombreCategoria" class="form-control" />
                        <span asp-validation-for="NombreCategoria" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-modern-primary">Guardar Cambios</button>
                        <a asp-action="Index" class="btn btn-modern-secondary">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
