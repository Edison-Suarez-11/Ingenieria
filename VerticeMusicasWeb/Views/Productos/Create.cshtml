@model VerticeMusicasWeb.Models.Producto
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-modern">
            <div class="card-body p-4">
                <h3 class="mb-3">Nuevo producto</h3>
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Leche entera" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CodigoBarras" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CodigoBarras"
                                       id="codigoBarrasInput"
                                       class="form-control"
                                       placeholder="Escanea o escribe el codigo"
                                       autocomplete="off"
                                       inputmode="numeric" />
                                <button type="button" class="btn btn-outline-secondary" id="btnIniciarEscaneoCamara">
                                    Escanear camara
                                </button>
                            </div>
                            <div class="form-text">
                                Si usas lector USB, ubica el cursor aqui y escanea.
                            </div>
                            <span asp-validation-for="CodigoBarras" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Marca" class="form-label"></label>
                            <input asp-for="Marca" class="form-control" placeholder="Opcional" />
                            <span asp-validation-for="Marca" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="IdCategoria" class="form-label"></label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select">
                                <option value="">Selecciona una categoria</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check mt-1">
                                <input asp-for="ManejaStock" class="form-check-input" />
                                <label asp-for="ManejaStock" class="form-check-label"></label>
                            </div>
                            <span asp-validation-for="ManejaStock" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-modern-primary">Guardar</button>
                        <a asp-action="Index" class="btn btn-modern-secondary">Volver</a>
                    </div>
                </form>

                <div class="mt-3 d-none" id="panelEscaneoCamara">
                    <div class="border rounded p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Escaner por camara</strong>
                            <button type="button" class="btn btn-sm btn-outline-danger" id="btnDetenerEscaneoCamara">
                                Detener
                            </button>
                        </div>
                        <video id="videoEscaner" class="w-100 rounded" playsinline muted></video>
                        <div class="form-text mt-2">
                            Enfoca el codigo de barras para capturarlo automaticamente.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const codigoInput = document.getElementById('codigoBarrasInput');
            const btnIniciar = document.getElementById('btnIniciarEscaneoCamara');
            const btnDetener = document.getElementById('btnDetenerEscaneoCamara');
            const panelCamara = document.getElementById('panelEscaneoCamara');
            const video = document.getElementById('videoEscaner');

            if (!codigoInput) {
                return;
            }

            codigoInput.focus();
            codigoInput.addEventListener('input', () => {
                codigoInput.value = codigoInput.value.replace(/\s+/g, '');
            });

            let stream = null;
            let detector = null;
            let scanLoopId = null;

            const detenerCamara = () => {
                if (scanLoopId) {
                    cancelAnimationFrame(scanLoopId);
                    scanLoopId = null;
                }
                if (stream) {
                    stream.getTracks().forEach(track => track.stop());
                    stream = null;
                }
                video.srcObject = null;
                panelCamara.classList.add('d-none');
            };

            const loopDeteccion = async () => {
                if (!detector || !video || video.readyState < 2) {
                    scanLoopId = requestAnimationFrame(loopDeteccion);
                    return;
                }

                try {
                    const codigos = await detector.detect(video);
                    if (codigos.length > 0) {
                        const valor = codigos[0].rawValue?.trim();
                        if (valor) {
                            codigoInput.value = valor.replace(/\s+/g, '');
                            codigoInput.dispatchEvent(new Event('input', { bubbles: true }));
                            codigoInput.focus();
                            detenerCamara();
                            return;
                        }
                    }
                } catch (_) {
                    // Ignora errores temporales de lectura para seguir escaneando.
                }

                scanLoopId = requestAnimationFrame(loopDeteccion);
            };

            const iniciarCamara = async () => {
                if (!('BarcodeDetector' in window)) {
                    alert('Tu navegador no soporta escaneo por camara. Usa el lector USB en el campo de codigo.');
                    return;
                }

                try {
                    detector = new BarcodeDetector({
                        formats: ['ean_13', 'ean_8', 'upc_a', 'upc_e', 'code_128', 'code_39', 'itf']
                    });
                    stream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: 'environment' },
                        audio: false
                    });
                    video.srcObject = stream;
                    await video.play();
                    panelCamara.classList.remove('d-none');
                    loopDeteccion();
                } catch (_) {
                    alert('No se pudo activar la camara. Revisa permisos del navegador.');
                    detenerCamara();
                }
            };

            btnIniciar?.addEventListener('click', iniciarCamara);
            btnDetener?.addEventListener('click', detenerCamara);
            window.addEventListener('beforeunload', detenerCamara);
        })();
    </script>
}
