@model VerticeMusicasWeb.Models.InformesViewModel
@{
    ViewData["Title"] = "Informes";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("es-CO");
    string fmtFecha(DateTime f) => f == DateTime.MinValue ? "-" : f.ToString("dd/MM/yyyy");
    string fmtMoney(decimal m) => m.ToString("C0", cultura);

    int filtrosActivos = 0;
    if (Model.Desde.HasValue) filtrosActivos++;
    if (Model.Hasta.HasValue) filtrosActivos++;
    if (Model.IdProveedor.HasValue) filtrosActivos++;
    if (Model.IdCategoria.HasValue) filtrosActivos++;
    if (!string.IsNullOrWhiteSpace(Model.TerminoBusqueda)) filtrosActivos++;
    if (Model.IdProductoComparar.HasValue) filtrosActivos++;
}

@section Styles {
    <link rel="stylesheet" href="~/css/informes.css" asp-append-version="true" />
}

<div class="informes-page">
    <header class="informes-header">
        <div>
            <h2>Informes</h2>
            <p>Resumen de ventas, compras, inventario y comparacion de precios por proveedor.</p>
        </div>
    </header>

    <div class="informes-print-meta only-print">
        <strong>Vertice Muisca — Informes</strong>
        <span id="informesPrintSeccionTitulo">Ventas — listado</span>
        <span>Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
        <span>Periodo: @(Model.Desde.HasValue && Model.Hasta.HasValue ? $"{Model.Desde:dd/MM/yyyy} — {Model.Hasta:dd/MM/yyyy}" : Model.Desde.HasValue ? $"Desde {Model.Desde:dd/MM/yyyy}" : Model.Hasta.HasValue ? $"Hasta {Model.Hasta:dd/MM/yyyy}" : "Todo el historial")</span>
    </div>

    <div class="card card-modern informes-toolbar">
        <button class="informes-toolbar-toggle @(filtrosActivos > 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#informesFiltros" aria-expanded="@(filtrosActivos > 0 ? "true" : "false")">
            <span>Filtros y periodo</span>
            @if (filtrosActivos > 0)
            {
                <span class="badge-filtros">@filtrosActivos activo@(filtrosActivos == 1 ? "" : "s")</span>
            }
        </button>
        <div class="collapse @(filtrosActivos > 0 ? "show" : "")" id="informesFiltros">
            <form method="get" id="form-informes" class="informes-filtros-grid">
                <div class="informes-f-col-2">
                    <div class="lbl">Desde</div>
                    <input type="date" name="desde" id="filtroDesde" class="form-control" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="informes-f-col-2">
                    <div class="lbl">Hasta</div>
                    <input type="date" name="hasta" id="filtroHasta" class="form-control" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="informes-f-col-4">
                    <div class="lbl">Periodo rapido</div>
                    <div class="informes-periodo-chips">
                        <button type="button" class="chip" data-range="hoy">Hoy</button>
                        <button type="button" class="chip" data-range="7d">7 dias</button>
                        <button type="button" class="chip" data-range="mes">Este mes</button>
                        <button type="button" class="chip" data-range="todo">Todo</button>
                    </div>
                </div>
                <div class="informes-f-col-3">
                    <div class="lbl">Proveedor</div>
                    <select name="idProveedor" asp-items="ViewBag.ProveedoresFiltro" class="form-select"></select>
                </div>
                <div class="informes-f-col-3">
                    <div class="lbl">Categoria</div>
                    <select name="idCategoria" asp-items="ViewBag.CategoriasFiltro" class="form-select"></select>
                </div>
                <div class="informes-f-col-4">
                    <div class="lbl">Buscar</div>
                    <input type="text" name="q" class="form-control" value="@ViewBag.Term" placeholder="Producto, codigo o proveedor" />
                </div>
                <div class="informes-f-col-4">
                    <div class="lbl">Comparar precios (producto)</div>
                    <select name="idProductoComparar" asp-items="ViewBag.ProductosComparar" class="form-select">
                        <option value="">Varios proveedores</option>
                    </select>
                </div>
                <div class="informes-f-col-12 informes-acciones">
                    <button type="submit" class="btn btn-modern-primary">Aplicar filtros</button>
                    <a asp-action="Index" class="btn btn-modern-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <div class="informes-kpis">
        <div class="informes-kpi">
            <small>Ventas</small>
            <strong>@Model.Resumen.TotalVentas</strong>
            <span class="sub">@fmtMoney(Model.Resumen.MontoTotalVentas)</span>
        </div>
        <div class="informes-kpi kpi-compras">
            <small>Compras</small>
            <strong>@fmtMoney(Model.Resumen.MontoTotalCompras)</strong>
            <span class="sub">@Model.Resumen.EntradasInventario entradas</span>
        </div>
        <div class="informes-kpi kpi-productos">
            <small>Productos</small>
            <strong>@Model.Resumen.TotalProductos</strong>
        </div>
        <div class="informes-kpi kpi-cat">
            <small>Categorias</small>
            <strong>@Model.Resumen.TotalCategorias</strong>
        </div>
        <div class="informes-kpi kpi-prov">
            <small>Proveedores</small>
            <strong>@Model.Resumen.TotalProveedores</strong>
        </div>
        <div class="informes-kpi kpi-unidades">
            <small>Unid. vendidas</small>
            <strong>@Model.Resumen.UnidadesVendidas</strong>
        </div>
    </div>

    <div class="card card-modern informes-panel">
        <div class="informes-nav-wrap">
            <div class="informes-tab-groups" role="tablist">
                <div class="informes-tab-group">
                    <label>Ventas</label>
                    <ul class="nav">
                        <li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-ventas" data-seccion="ventas" type="button">Listado</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-top" data-seccion="mas-vendidos" type="button">Mas vendidos</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-salidas" data-seccion="salidas" type="button">Salidas</button></li>
                    </ul>
                </div>
                <div class="informes-tab-group">
                    <label>Compras</label>
                    <ul class="nav">
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-entradas" data-seccion="entradas" type="button">Entradas</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-compras-prov" data-seccion="compras-proveedor" type="button">Por proveedor</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comparacion" data-seccion="comparacion" type="button">Comparar precios</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-proveedores" data-seccion="proveedores" type="button">Directorio prov.</button></li>
                    </ul>
                </div>
                <div class="informes-tab-group">
                    <label>Catalogo</label>
                    <ul class="nav">
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-productos" data-seccion="productos" type="button">Productos</button></li>
                        <li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-categorias" data-seccion="categorias" type="button">Categorias</button></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="informes-panel-export no-print">
            <div class="informes-panel-export-label">
                <small class="text-muted">Seccion visible</small>
                <strong id="informesSeccionActivaLabel">Ventas — listado</strong>
            </div>
            <div class="informes-panel-export-btns">
                <button type="button" class="btn btn-sm btn-modern-secondary" id="btnImprimirSeccion" title="Imprimir solo esta seccion">
                    Imprimir
                </button>
                <button type="button" class="btn btn-sm btn-modern-primary" id="btnExportarPdfSeccion" title="Descargar PDF de esta seccion">
                    Exportar PDF
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnExportarPdfCompleto" title="PDF con todas las secciones">
                    PDF completo
                </button>
            </div>
            <form id="formExportPdf" method="get" asp-action="ExportPdf" class="d-none" aria-hidden="true">
                <input type="hidden" name="desde" id="pdfDesde" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="hasta" id="pdfHasta" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="idProductoComparar" id="pdfIdProductoComparar" value="@Model.IdProductoComparar" />
                <input type="hidden" name="idProveedor" id="pdfIdProveedor" value="@Model.IdProveedor" />
                <input type="hidden" name="idCategoria" id="pdfIdCategoria" value="@Model.IdCategoria" />
                <input type="hidden" name="q" id="pdfQ" value="@Model.TerminoBusqueda" />
                <input type="hidden" name="seccion" id="pdfSeccion" value="ventas" />
            </form>
        </div>

        <div class="tab-content informes-panel-body" id="informesTabContent">
            <div class="tab-pane fade show active informes-print-section" id="tab-ventas" data-seccion="ventas" data-print-title="Ventas — listado">
                @if (Model.Ventas.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">📋</div><p>No hay ventas en el periodo seleccionado.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>#</th><th>Fecha</th><th>Pago</th><th class="text-end">Total</th><th class="text-end">Uds.</th><th>Detalle</th></tr></thead>
                            <tbody>
                            @foreach (var v in Model.Ventas)
                            {
                                <tr>
                                    <td><span class="text-muted">@v.IdVenta</span></td>
                                    <td>@fmtFecha(v.Fecha)</td>
                                    <td><span class="informes-badge informes-badge-venta">@v.MetodoPago</span></td>
                                    <td class="text-end fw-semibold">@fmtMoney(v.Total)</td>
                                    <td class="text-end">@v.Unidades</td>
                                    <td class="small text-muted">@v.DetalleProductos</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-entradas" data-seccion="entradas" data-print-title="Entradas de inventario">
                @if (Model.EntradasInventario.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">📦</div><p>No hay entradas de inventario en el periodo.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>Fecha</th><th>Producto</th><th>Proveedor</th><th>Categoria</th><th class="text-end">Cant.</th><th class="text-end">P. compra</th><th class="text-end">Total</th></tr></thead>
                            <tbody>
                            @foreach (var e in Model.EntradasInventario)
                            {
                                <tr>
                                    <td>@fmtFecha(e.Fecha)</td>
                                    <td>@e.NombreProducto<br /><small class="text-muted">@e.CodigoBarras</small></td>
                                    <td>@e.NombreProveedor</td>
                                    <td>@e.NombreCategoria</td>
                                    <td class="text-end text-success fw-semibold">+@e.Cantidad</td>
                                    <td class="text-end">@(e.PrecioUnitarioCompra.HasValue ? fmtMoney(e.PrecioUnitarioCompra.Value) : "—")</td>
                                    <td class="text-end">@fmtMoney(e.TotalCompra)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-compras-prov" data-seccion="compras-proveedor" data-print-title="Compras por proveedor">
                @if (Model.ComprasPorProveedor.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">🛒</div><p>No hay compras con precio registrado.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>Fecha</th><th>Proveedor</th><th>Producto</th><th class="text-end">Cant.</th><th class="text-end">P. unit.</th><th class="text-end">Total</th></tr></thead>
                            <tbody>
                            @foreach (var c in Model.ComprasPorProveedor)
                            {
                                <tr>
                                    <td>@fmtFecha(c.Fecha)</td>
                                    <td>@c.NombreProveedor</td>
                                    <td>@c.NombreProducto</td>
                                    <td class="text-end">@c.Cantidad</td>
                                    <td class="text-end">@fmtMoney(c.PrecioUnitario)</td>
                                    <td class="text-end fw-semibold">@fmtMoney(c.TotalLinea)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-comparacion" data-seccion="comparacion" data-print-title="Comparacion de precios">
                @if (Model.ComparacionPreciosProveedores.Count == 0)
                {
                    <div class="informes-empty">
                        <div class="icon">⚖️</div>
                        <p>No hay productos con varios proveedores en el periodo.<br />Registra entradas con distintos proveedores y precios, o elige un producto en los filtros.</p>
                    </div>
                }
                else
                {
                    @foreach (var item in Model.ComparacionPreciosProveedores)
                    {
                        <div class="informes-compare-card">
                            <div class="informes-compare-head">
                                <div>
                                    <div class="title">@item.NombreProducto</div>
                                    <div class="meta">@item.CodigoBarras · @item.NombreCategoria</div>
                                </div>
                                <div class="d-flex flex-wrap gap-1 justify-content-end">
                                    <span class="informes-badge informes-badge-venta">Venta @fmtMoney(item.PrecioVenta)</span>
                                    @if (item.PrecioCompraMasBajo.HasValue)
                                    {
                                        <span class="informes-badge informes-badge-mejor">Mejor: @fmtMoney(item.PrecioCompraMasBajo.Value) · @item.ProveedorMasEconomico</span>
                                    }
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-modern mb-0">
                                    <thead><tr><th>Proveedor</th><th class="text-end">Ultimo</th><th class="text-end">Min</th><th class="text-end">Max</th><th class="text-end">Prom.</th><th class="text-end">N°</th><th>Ult. fecha</th></tr></thead>
                                    <tbody>
                                    @foreach (var pr in item.PreciosPorProveedor)
                                    {
                                        var esMejor = pr.UltimoPrecio == item.PrecioCompraMasBajo;
                                        <tr class="@(esMejor ? "table-success" : "")">
                                            <td>@pr.NombreProveedor</td>
                                            <td class="text-end fw-semibold">@(pr.UltimoPrecio.HasValue ? fmtMoney(pr.UltimoPrecio.Value) : "—")</td>
                                            <td class="text-end">@(pr.PrecioMinimo.HasValue ? fmtMoney(pr.PrecioMinimo.Value) : "—")</td>
                                            <td class="text-end">@(pr.PrecioMaximo.HasValue ? fmtMoney(pr.PrecioMaximo.Value) : "—")</td>
                                            <td class="text-end">@(pr.PrecioPromedio.HasValue ? fmtMoney(pr.PrecioPromedio.Value) : "—")</td>
                                            <td class="text-end">@pr.NumeroCompras</td>
                                            <td>@(pr.FechaUltimaCompra.HasValue && pr.FechaUltimaCompra != DateTime.MinValue ? fmtFecha(pr.FechaUltimaCompra.Value) : "—")</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-proveedores" data-seccion="proveedores" data-print-title="Resumen de proveedores">
                @if (Model.Proveedores.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">🏢</div><p>No hay proveedores registrados.</p></div>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>Proveedor</th><th class="text-end">Compras</th><th class="text-end">Uds.</th><th class="text-end">Productos</th><th class="text-end">Monto</th></tr></thead>
                            <tbody>
                            @foreach (var p in Model.Proveedores)
                            {
                                <tr>
                                    <td><a asp-controller="Proveedores" asp-action="Index">@p.NombreProveedor</a></td>
                                    <td class="text-end">@p.NumeroCompras</td>
                                    <td class="text-end">@p.UnidadesCompradas</td>
                                    <td class="text-end">@p.ProductosDistintos</td>
                                    <td class="text-end fw-semibold">@fmtMoney(p.MontoTotalCompras)</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <h6 class="mb-2">Datos de contacto y ubicacion</h6>
                    <div class="row g-2">
                    @foreach (var p in Model.Proveedores)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="border rounded-3 p-3 h-100 bg-white">
                                <div class="fw-semibold mb-1">
                                    <a asp-controller="Proveedores" asp-action="Index">@p.NombreProveedor</a>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Nit))
                                {
                                    <div class="small text-muted mb-1">NIT @p.Nit</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.PersonaContacto))
                                {
                                    <div class="small"><span class="text-muted">Contacto:</span> @p.PersonaContacto</div>
                                }
                                <div class="small"><span class="text-muted">Celular:</span> @(p.Celular ?? "—")</div>
                                <div class="small"><span class="text-muted">Correo:</span> @(p.CorreoElectronico ?? "—")</div>
                                <div class="small"><span class="text-muted">Tel. fijo:</span> @(p.TelefonoFijo ?? "—")</div>
                                <div class="small"><span class="text-muted">Ciudad:</span> @(p.Ciudad ?? "—")</div>
                                <div class="small"><span class="text-muted">Direccion:</span> @(p.Direccion ?? "—")</div>
                            </div>
                        </div>
                    }
                    </div>
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-productos" data-seccion="productos" data-print-title="Catalogo de productos">
                <div class="table-responsive">
                    <table class="table table-modern table-hover mb-0">
                        <thead><tr><th>Producto</th><th>Codigo</th><th>Categoria</th><th>Marca</th><th class="text-end">P. venta</th><th class="text-end">Stock</th><th>Mejor prov.</th><th class="text-end">Mejor compra</th></tr></thead>
                        <tbody>
                        @foreach (var p in Model.ProductosCatalogo)
                        {
                            <tr>
                                <td>@p.NombreProducto</td>
                                <td class="text-muted small">@p.CodigoBarras</td>
                                <td>@p.NombreCategoria</td>
                                <td>@(p.Marca ?? "—")</td>
                                <td class="text-end">@fmtMoney(p.PrecioVenta)</td>
                                <td class="text-end">@p.StockDisponible</td>
                                <td>@(p.MejorProveedor ?? "—")</td>
                                <td class="text-end">@(p.MejorPrecioCompra.HasValue ? fmtMoney(p.MejorPrecioCompra.Value) : "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-categorias" data-seccion="categorias" data-print-title="Categorias">
                <div class="table-responsive">
                    <table class="table table-modern table-hover mb-0">
                        <thead><tr><th>Categoria</th><th class="text-end">Productos</th><th class="text-end">Stock total</th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categorias)
                        {
                            <tr><td>@c.NombreCategoria</td><td class="text-end">@c.CantidadProductos</td><td class="text-end">@c.StockTotal</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-salidas" data-seccion="salidas" data-print-title="Salidas de inventario">
                @if (Model.SalidasInventario.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">📤</div><p>No hay salidas en el periodo.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>Fecha</th><th>Producto</th><th>Categoria</th><th class="text-end">Cant.</th><th>Motivo</th></tr></thead>
                            <tbody>
                            @foreach (var s in Model.SalidasInventario)
                            {
                                <tr>
                                    <td>@fmtFecha(s.Fecha)</td>
                                    <td>@s.NombreProducto</td>
                                    <td>@s.NombreCategoria</td>
                                    <td class="text-end text-danger fw-semibold">-@s.Cantidad</td>
                                    <td class="small text-muted">@s.Motivo</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-pane fade informes-print-section" id="tab-top" data-seccion="mas-vendidos" data-print-title="Productos mas vendidos">
                @if (Model.ProductosMasVendidos.Count == 0)
                {
                    <div class="informes-empty"><div class="icon">🏆</div><p>No hay ventas en el periodo para este ranking.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-modern table-hover mb-0">
                            <thead><tr><th>#</th><th>Producto</th><th>Codigo</th><th class="text-end">Unidades</th><th class="text-end">Monto</th></tr></thead>
                            <tbody>
                            @{ var rank = 1; }
                            @foreach (var p in Model.ProductosMasVendidos)
                            {
                                <tr>
                                    <td><span class="informes-badge informes-badge-venta">@rank</span></td>
                                    <td>@p.NombreProducto</td>
                                    <td class="text-muted small">@p.CodigoBarras</td>
                                    <td class="text-end fw-semibold">@p.UnidadesVendidas</td>
                                    <td class="text-end">@fmtMoney(p.MontoTotal)</td>
                                </tr>
                                rank++;
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const formFiltros = document.getElementById('form-informes');
            const desde = document.getElementById('filtroDesde');
            const hasta = document.getElementById('filtroHasta');

            const labelSeccion = document.getElementById('informesSeccionActivaLabel');
            const printTitulo = document.getElementById('informesPrintSeccionTitulo');
            const btnPrint = document.getElementById('btnImprimirSeccion');
            const btnPdf = document.getElementById('btnExportarPdfSeccion');
            const btnPdfCompleto = document.getElementById('btnExportarPdfCompleto');
            const formPdf = document.getElementById('formExportPdf');
            const pdfSeccion = document.getElementById('pdfSeccion');
            const tabContent = document.getElementById('informesTabContent');
            const navLinks = () => document.querySelectorAll('.informes-panel [data-bs-toggle="tab"][data-seccion]');

            let seccionActiva = 'ventas';
            let tituloActivo = 'Ventas — listado';

            const panelPorSeccion = (seccion) =>
                tabContent?.querySelector(`.tab-pane[data-seccion="${seccion}"]`) ?? null;

            const activarSeccion = (btn) => {
                const seccion = btn?.dataset?.seccion;
                if (!seccion) return;

                seccionActiva = seccion;
                const panel = panelPorSeccion(seccion);
                tituloActivo = panel?.dataset.printTitle || 'Informe';

                navLinks().forEach(link => link.classList.remove('active'));
                btn.classList.add('active');

                tabContent?.querySelectorAll('.tab-pane').forEach(pane => {
                    pane.classList.remove('show', 'active');
                });
                if (panel) {
                    panel.classList.add('show', 'active');
                }
            };

            const obtenerSeccionActiva = () => ({
                seccion: seccionActiva,
                titulo: tituloActivo
            });

            const obtenerPanelActivo = () => panelPorSeccion(seccionActiva);

            const sincronizarFiltrosPdf = () => {
                if (!formPdf) return;
                const set = (id, val) => {
                    const el = document.getElementById(id);
                    if (el) el.value = val ?? '';
                };
                set('pdfDesde', desde?.value);
                set('pdfHasta', hasta?.value);
                const prov = document.querySelector('[name="idProveedor"]');
                const cat = document.querySelector('[name="idCategoria"]');
                const prod = document.querySelector('[name="idProductoComparar"]');
                const q = document.querySelector('[name="q"]');
                set('pdfIdProveedor', prov?.value);
                set('pdfIdCategoria', cat?.value);
                set('pdfIdProductoComparar', prod?.value);
                set('pdfQ', q?.value);
            };

            const actualizarExportacionSeccion = () => {
                const { seccion, titulo } = obtenerSeccionActiva();
                if (labelSeccion) labelSeccion.textContent = titulo || 'Informe';
                if (printTitulo) printTitulo.textContent = titulo || 'Informe';
                if (pdfSeccion) pdfSeccion.value = seccion;
                sincronizarFiltrosPdf();
            };

            const enviarPdf = (seccion) => {
                if (!formPdf || !pdfSeccion) return;
                sincronizarFiltrosPdf();
                pdfSeccion.value = seccion;
                formPdf.submit();
            };

            navLinks().forEach(btn => {
                btn.addEventListener('shown.bs.tab', (e) => {
                    activarSeccion(e.target);
                    actualizarExportacionSeccion();
                });
                btn.addEventListener('click', (e) => {
                    activarSeccion(e.currentTarget);
                    actualizarExportacionSeccion();
                });
            });

            const inicial = document.querySelector('.informes-panel .nav-link.active[data-seccion]')
                || navLinks()[0];
            if (inicial) activarSeccion(inicial);
            actualizarExportacionSeccion();

            btnPdf?.addEventListener('click', () => {
                const { seccion } = obtenerSeccionActiva();
                enviarPdf(seccion);
            });

            btnPdfCompleto?.addEventListener('click', () => enviarPdf('completo'));

            btnPrint?.addEventListener('click', () => {
                activarSeccion(
                    document.querySelector(`.informes-panel .nav-link[data-seccion="${seccionActiva}"]`)
                    || navLinks()[0]);
                const panel = obtenerPanelActivo();
                const panes = document.querySelectorAll('.informes-print-section');
                const estilosGuardados = [];

                panes.forEach(p => {
                    estilosGuardados.push({ el: p, display: p.style.display });
                    p.classList.remove('informes-print-active');
                    p.style.display = 'none';
                });

                if (panel) {
                    panel.classList.add('informes-print-active');
                    panel.style.display = 'block';
                }

                document.body.classList.add('informes-printing-one');

                const cleanup = () => {
                    document.body.classList.remove('informes-printing-one');
                    estilosGuardados.forEach(({ el, display }) => {
                        el.style.display = display;
                        el.classList.remove('informes-print-active');
                    });
                };

                window.addEventListener('afterprint', cleanup, { once: true });
                window.print();
                setTimeout(cleanup, 1500);
            });

            if (formFiltros && desde && hasta) {
                const fmt = d => d.toISOString().slice(0, 10);
                document.querySelectorAll('[data-range]').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const hoy = new Date();
                        const range = btn.getAttribute('data-range');
                        let d1 = null, d2 = null;

                        if (range === 'hoy') {
                            d1 = d2 = hoy;
                        } else if (range === '7d') {
                            d2 = hoy;
                            d1 = new Date(hoy);
                            d1.setDate(d1.getDate() - 6);
                        } else if (range === 'mes') {
                            d1 = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
                            d2 = hoy;
                        } else {
                            desde.value = '';
                            hasta.value = '';
                            formFiltros.submit();
                            return;
                        }

                        desde.value = fmt(d1);
                        hasta.value = fmt(d2);
                        document.querySelectorAll('[data-range]').forEach(c => c.classList.remove('active'));
                        btn.classList.add('active');
                        formFiltros.submit();
                    });
                });
            }
        })();
    </script>
}
